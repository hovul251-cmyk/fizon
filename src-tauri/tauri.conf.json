{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fizion",
  "version": "0.10.0",
  "identifier": "app.fizion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fizion",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0A1324"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://*.appwrite.io https://*.appwrite.global https://i.ytimg.com; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://rutube.ru; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://*.appwrite.io wss://*.appwrite.io https://*.livekit.cloud wss://*.livekit.cloud https://api.github.com https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Мессенджер для сообществ",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMjcxNEQzQzBCNjI1QkYKUldTL0piYkEweFFuVGRjK2YxL3cvOEt2QVVaN3BKWlZrSFc0R25kS1F0T05BQVBSMlk0YzFkd0YK",
      "endpoints": [
        "https://github.com/hovul251-cmyk/fizon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
